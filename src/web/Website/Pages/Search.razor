@page "/search"
@namespace GetTogether.Web.Pages
@using MudBlazor

<PageTitle>Search Events | Get Together</PageTitle>

<div class="search-container">
    <h1>Search Events</h1>

    <div class="search-form">
        <div style="margin-bottom: 1.5rem;">
            <MudTextField @bind-Value="SearchTerm" Label="Search Term" Variant="Variant.Outlined" 
                          OnKeyDown="@CheckForEnterKey" Placeholder="Enter event title, location, or keyword..." />
        </div>
        <div style="margin-bottom: 1.5rem;">
            <MudSelect T="int?" @bind-Value="SelectedCircleId" Label="Circle" Variant="Variant.Outlined"
                       Style="border-radius: 12px;">
                <MudSelectItem T="int?" Value="@((int?)null)">All My Circles</MudSelectItem>
                @foreach (var circle in userCircles)
                {
                    <MudSelectItem T="int?" Value="@((int?)circle.CircleId)">@circle.Name</MudSelectItem>
                }
            </MudSelect>
        </div>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" id="btnSearch" OnClick="ExecuteSearch">Search Events</MudButton>
    </div>

    @if (hasSearched)
    {
        <div class="search-results mt-4">
            @if (matchingEvents.Any())
            {
                <div class="d-flex flex-column gap-3" style="list-style-type: none; padding: 0;">
                    @foreach (var evt in matchingEvents)
                    {
                        <div class="card p-3 shadow-sm border-0">
                            <div class="d-flex justify-content-between align-items-start">
                                <div>
                                    <h2 class="h5 mb-1">
                                        <a href="/events/detail/@evt.EventId" class="text-decoration-none">@evt.Title</a>
                                    </h2>
                                    <span class="badge bg-secondary mb-2">@evt.CircleName</span>
                                    <p class="text-muted small mb-1">
                                        <i class="fas fa-clock me-1"></i>@evt.StartUtc.ToLocalTime().ToString("g")
                                        @if (!string.IsNullOrEmpty(evt.Location))
                                        {
                                            <span class="ms-3"><i class="fas fa-map-marker-alt me-1"></i>@evt.Location</span>
                                        }
                                    </p>
                                    @if (!string.IsNullOrEmpty(evt.Description))
                                    {
                                        <p class="mb-0 text-secondary">@evt.Description</p>
                                    }
                                </div>
                                <a href="/events/detail/@evt.EventId" class="btn btn-outline-primary btn-sm ms-2">Details</a>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="alert alert-info mt-3">
                    No matching events found. Try adjusting your search term or circle filter.
                </div>
            }
        </div>
    }
</div>
