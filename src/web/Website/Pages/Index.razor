@page "/"
@namespace GetTogether.Web.Pages
@using MudBlazor

<PageTitle>@(isNinetiesTheme ? "The Grand Get Together" : Data.Constants.ApplicationTitle)</PageTitle>

<div class="page-container">
    <MudContainer MaxWidth="MaxWidth.Large">
        <div class="home-heading">
            <h1>@(isNinetiesTheme ? "The Grand Get Together" : "Get Together")</h1>
            <p class="lead text-muted">Simple, private event planning for real friends.</p>
        </div>

        <div class="hero-card mb-5 p-4 rounded-3 shadow-sm">
            <h2 class="h4 mb-3">Welcome to Get Together</h2>
            <p class="mb-0">
                Organize informal gatherings — pickleball, movie nights, standing coffee dates, or volunteer shifts — without the bloat of public event platforms. Create a circle of friends, post a thing to do, and everyone taps Accept, Decline, or Maybe. That's it!
            </p>
        </div>

        <div class="row g-4 mb-4">
            <div class="col-md-4">
                <div class="card h-100 shadow-sm border-0">
                    <div class="card-body d-flex flex-column p-4">
                        <div class="d-flex align-items-center mb-3">
                            <MudIcon Icon="@Icons.Material.Filled.Groups" Color="Color.Primary" Size="Size.Large" Class="me-2" />
                            <h3 class="h5 mb-0">Circles</h3>
                        </div>
                        <p class="card-text text-muted flex-grow-1">
                            Create private groups for your friend circles, view member rosters, and generate single-use invitation codes.
                        </p>
                        <a href="circles" class="btn btn-primary mt-3">Manage Circles</a>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card h-100 shadow-sm border-0">
                    <div class="card-body d-flex flex-column p-4">
                        <div class="d-flex align-items-center mb-3">
                            <MudIcon Icon="@Icons.Material.Filled.Event" Color="Color.Primary" Size="Size.Large" Class="me-2" />
                            <h3 class="h5 mb-0">Events</h3>
                        </div>
                        <p class="card-text text-muted flex-grow-1">
                            Post one-off or recurring events, choose per-occurrence or series RSVP mode, and track member responses.
                        </p>
                        <a href="events" class="btn btn-primary mt-3">View Events</a>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card h-100 shadow-sm border-0">
                    <div class="card-body d-flex flex-column p-4">
                        <div class="d-flex align-items-center mb-3">
                            <MudIcon Icon="@Icons.Material.Filled.CalendarMonth" Color="Color.Primary" Size="Size.Large" Class="me-2" />
                            <h3 class="h5 mb-0">Calendar</h3>
                        </div>
                        <p class="card-text text-muted flex-grow-1">
                            View upcoming events across all your circles in an interactive month grid or chronological agenda list.
                        </p>
                        <a href="calendar" class="btn btn-primary mt-3">Open Calendar</a>
                    </div>
                </div>
            </div>
        </div>

        @if (isNinetiesTheme)
        {
            <div style="text-align: center; margin-top: 30px;">
                <a href="https://en.wikipedia.org/wiki/Dancing_baby" target="_blank" style="text-decoration: none;">
                    <img src="/DancingBaby.gif" alt="Dancing Baby" style="max-width: 200px; cursor: pointer;" />
                </a>
            </div>
        }
    </MudContainer>
</div>
