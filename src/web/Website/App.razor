@namespace GetTogether.Web

<CascadingAuthenticationState>
    <Router AppAssembly="@typeof(App).Assembly">
    <Found Context="routeData">
        <AuthorizeRouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)">
            <NotAuthorized>
                <div class="container" style="padding: 25px;">
                    <div class="alert alert-warning">
                        <h4>Access Denied</h4>
                        <p>You are not authorized to access this page.</p>
                        @if (IsAuthEnabled)
                        {
                            <p><a href="/login">Please sign in</a> to continue.</p>
                        }
                        else
                        {
                            <p>Authentication is not configured for this environment.</p>
                        }
                    </div>
                </div>
            </NotAuthorized>
            <Authorizing>
                <div class="container" style="padding: 25px;">
                    <p>Checking authorization...</p>
                </div>
            </Authorizing>
        </AuthorizeRouteView>
        <FocusOnNavigate RouteData="@routeData" Selector="h1" />
    </Found>
    <NotFound>
        <PageTitle>Not found</PageTitle>
        <LayoutView Layout="@typeof(MainLayout)">
            <p role="alert">Sorry, there's nothing at this address.</p>
        </LayoutView>
    </NotFound>
    </Router>
</CascadingAuthenticationState>

@code {
    [Inject] private IConfiguration Configuration { get; set; } = default!;

    private bool IsAuthEnabled => !string.IsNullOrWhiteSpace(Configuration["AzureAD:TenantId"])
        || HasConfiguration("Authentication:Google:ClientId", "Authentication:Google:ClientSecret")
        || HasConfiguration("Authentication:Facebook:AppId", "Authentication:Facebook:AppSecret");

    private bool HasConfiguration(params string[] keys) => keys.All(key => !string.IsNullOrWhiteSpace(Configuration[key]));
}
